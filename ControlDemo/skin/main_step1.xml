                 font="2" height="20" textcolor="0xFF666666"/>
          <Label text="本页留出空白区域，避免自动实例化系统组件；实际用法：&lt;ActiveX clsid=&quot;{8856F961-340A-11D0-A96B-00C04FD705A2}&quot; /&gt;"
                 font="2" height="20" textcolor="0xFF666666"/>
          <Label text="② Window 属性演示（sizebox/caption/roundcorner/mininfo 已在本窗口顶部 XML 配置）" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <HorizontalLayout height="34" childpadding="10">
            <Button name="btnRound"   text="切换圆角开/关" width="150"/>
            <Button name="btnShadow"  text="切换窗口阴影"   width="150"/>
            <Button name="btnDpi"     text="DPI 缩放 100%↔125%" width="180"/>
            <Button name="btnHSL"     text="HSL 换色演示"   width="150"/>
          </HorizontalLayout>

          <Label text="③ Include / Import / Default / Style / Font（全局节点）" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <VerticalLayout bkcolor="0xFFF7F9FC" bordercolor="0xFFE2E6ED" bordersize="1" inset="12,10,12,10" childpadding="6" height="130">
            <Label text="&lt;Font id=&quot;0&quot; name=&quot;微软雅黑&quot; size=&quot;14&quot;/&gt;   —— 全局字体定义，控件用 font=&quot;id&quot; 引用" font="2" textcolor="0xFF666666" height="22"/>
            <Label text="&lt;Default name=&quot;Button&quot; value=&quot;font='0' …/&gt;   —— 控件默认属性，本 Demo 顶部已定义按钮全局样式" font="2" textcolor="0xFF666666" height="22"/>
            <Label text="&lt;Style name=&quot;btnBlue&quot; value=&quot;bkcolor='0xFF3A7AFF' …/&gt;   —— 样式表，控件用 style=&quot;btnBlue&quot; 应用" font="2" textcolor="0xFF666666" height="22"/>
            <Label text="&lt;Include source=&quot;xxx.xml&quot;/&gt;   —— 嵌入外部 XML；&lt;Import fontfile=&quot;x.ttf&quot;/&gt;   —— 加载字体文件" font="2" textcolor="0xFF666666" height="22"/>
            <Label text="&lt;ChildLayout xmlfile=&quot;child_panel.xml&quot;/&gt;   —— 独立窗口树嵌入，见“布局容器”页 ⑤" font="2" textcolor="0xFF666666" height="22"/>
          </VerticalLayout>

          <Label text="④ Menu（右键弹出菜单）— 在下方区域点击右键体验" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <VerticalLayout name="menuArea" bkcolor="0xFFFFF0F0" bordercolor="0xFFF0B8B8" bordersize="1" height="110" inset="10,8,10,8">
            <Label text="🖱️ 在此区域点击鼠标右键 → 弹出 CMenuWnd 菜单（Menu/MenuElement 控件）" textcolor="0xFFC43838" font="0" align="center" vcenter="true"/>
            <Label text="菜单项支持 icon / checkitem / linetype(分隔线) / 子菜单，代码驱动 ShowMenu" textcolor="0xFFD88080" font="2" align="center"/>
          </VerticalLayout>
        </VerticalLayout>


        
    </HorizontalLayout>

    <!-- ===================== 状态栏 ===================== -->
    <HorizontalLayout height="26" bkcolor="0xFFE9EDF4" inset="12,0,12,0">
      <Label name="lblStatus" text="就绪。左侧导航切换页签；列表头可拖动排序宽度；右键红区弹菜单。" font="2" textcolor="0xFF8A94A6" align="left" vcenter="true"/>
    </HorizontalLayout>
  </VerticalLayout>
</Window>
