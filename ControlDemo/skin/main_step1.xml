<?xml version="1.0" encoding="UTF-8"?>
<Window size="1180,760" mininfo="960,640" sizebox="4,4,6,6" caption="0,0,0,32" roundcorner="16,16"
        disabledfontcolor="0xFFA7A6AA" defaultfontcolor="0xFF333333" linkfontcolor="0xFF1E6FFF"
        linkhoverfontcolor="0xFFD3215F" selectedcolor="0xFFBAE4FF">
  <Font id="0" name="微软雅黑" size="14" bold="false"/>
  <Font id="1" name="微软雅黑" size="15" bold="true"/>
  <Font id="2" name="微软雅黑" size="12" bold="false"/>
  <Default name="Button" value="font=&quot;0&quot; textcolor=&quot;0xFF333333&quot; hottextcolor=&quot;0xFFFFFFFF&quot; pushedtextcolor=&quot;0xFFFFFFFF&quot; hotbkcolor=&quot;0xFF3A7AFF&quot; pushedbkcolor=&quot;0xFF2A62D9&quot; bordersize=&quot;1&quot; bordercolor=&quot;0xFFD8DCE3&quot;"/>

  <VerticalLayout bkcolor="0xFFF3F5F9">

    <!-- ===================== 标题栏 ===================== -->
    <HorizontalLayout height="32" bkcolor="0xFF2D5BD7">
      <VerticalLayout inset="10,0,0,0">
        <Label text="DuiLib 控件全家桶 Demo（覆盖属性列表全部控件）" font="1" textcolor="0xFFFFFFFF" align="left" vcenter="true"/>
      </VerticalLayout>
      <Button name="btnMin" text="—" width="44" bordersize="0" hotbkcolor="0xFF4A76E0" pushedbkcolor="0xFF244CBB" textcolor="0xFFFFFFFF"/>
      <Button name="btnClose" text="✕" width="44" bordersize="0" hotbkcolor="0xFFE64C4C" pushedbkcolor="0xFFC43838" textcolor="0xFFFFFFFF"/>
    </HorizontalLayout>

    <!-- ===================== 主体：左侧导航 + 右侧 Tab 页 ===================== -->
    <HorizontalLayout inset="12,12,12,12" childpadding="10">

      <!-- 左侧导航按钮组（绑定 TabLayout） -->
      <VerticalLayout width="200" bkcolor="0xFFFFFFFF" bordercolor="0xFFE2E6ED" bordersize="1" inset="8,10,8,10" childpadding="6">
        <Label text="— 控件导航 —" font="2" textcolor="0xFF8A94A6" height="26" align="center"/>
        <Button text="基础控件"       bindtablayoutname="tabMain" bindtabindex="0" height="34"/>
        <Button text="输入控件"       bindtablayoutname="tabMain" bindtabindex="1" height="34"/>
        <Button text="高级控件"       bindtablayoutname="tabMain" bindtabindex="2" height="34"/>
        <Button text="列表与树"       bindtablayoutname="tabMain" bindtabindex="3" height="34"/>
        <Button text="布局容器"       bindtablayoutname="tabMain" bindtabindex="4" height="34"/>
        <Button text="动效与多媒体"   bindtablayoutname="tabMain" bindtabindex="5" height="34"/>
        <Button text="窗口与嵌入"     bindtablayoutname="tabMain" bindtabindex="6" height="34"/>
        <Button text="HTML界面"       bindtablayoutname="tabMain" bindtabindex="7" height="34"/>
      </VerticalLayout>

      <!-- 右侧 Tab 主体 -->
      <TabLayout name="tabMain" bkcolor="0xFFFFFFFF" bordercolor="0xFFE2E6ED" bordersize="1" inset="14,14,14,14" selected="0">

        <!-- ============ 第0页：基础控件 ============ -->
        <VerticalLayout inset="0,0,0,0" childpadding="10">
          <Label text="① Label（标签）— align / valign / wordbreak" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <HorizontalLayout height="52" childpadding="8">
            <Label text="左对齐" width="110" bkcolor="0xFFEAF1FF" textcolor="0xFF2D5BD7" align="left" inset="8,0,0,0"/>
            <Label text="居中"   width="110" bkcolor="0xFFEAF1FF" textcolor="0xFF2D5BD7" align="center"/>
            <Label text="右对齐" width="110" bkcolor="0xFFEAF1FF" textcolor="0xFF2D5BD7" align="right" inset="0,0,8,0"/>
            <Label text="Text 控件：支持 SelectText 选中复制的一段静态文本，与 Label 的区别在于可选中。" mouse="false" align="left" vcenter="true" inset="8,0,0,0"/>
          </HorizontalLayout>

          <Label text="② Button（按钮）— normal/hot/pushed/focused/disabled 状态图与状态色" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <HorizontalLayout height="36" childpadding="8">
            <Button text="普通按钮"     width="120"/>
            <Button text="禁用按钮"     width="120" enabled="false"/>
            <Button text="自定义配色"   width="140" bkcolor="0xFF28C76F" hotbkcolor="0xFF22AD60" pushedbkcolor="0xFF1B8F4F"
                    bordercolor="0xFF28C76F" textcolor="0xFFFFFFFF" hottextcolor="0xFFFFFFFF" pushedtextcolor="0xFFFFFFFF"/>
            <Button name="btnMsg" text="点击弹提示" width="140"/>
            <Button text="onClick 绑定 Tab" width="170" bindtablayoutname="tabMain" bindtabindex="5"/>
          </HorizontalLayout>

          <Label text="③ Option（单选/复选）— group 分组互斥 / selected" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <HorizontalLayout height="30" childpadding="14">
            <Option text="苹果"  group="fruit"  width="90" font="0" selected="true"/>
            <Option text="香蕉"  group="fruit"  width="90" font="0"/>
            <Option text="橘子"  group="fruit"  width="90" font="0"/>
            <Option name="optCheck" text="复选框（独立）" width="140" font="0"/>
            <CheckBox name="chkBox" text="CheckBox 控件" width="140" font="0"/>
          </HorizontalLayout>

          <Label text="④ GroupBox（分组框）" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <GroupBox text="GroupBox 分组标题" height="70" inset="14,4,14,10" childpadding="8" bordercolor="0xFFD8DCE3" bordersize="1">
            <HorizontalLayout height="24" childpadding="14">
              <Option text="男" group="sex" width="80" font="0" selected="true"/>
              <Option text="女" group="sex" width="80" font="0"/>
              <Label text="GroupBox 继承自 HorizontalLayout，可包含任意子控件" textcolor="0xFF8A94A6" align="left" vcenter="true" inset="20,0,0,0"/>
            </HorizontalLayout>
          </GroupBox>

          <Label text="⑤ Progress（进度条）与 Slider（滑块）" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <Progress name="progressDemo" value="60" height="14" forecolor="0xFF3A7AFF" bkcolor="0xFFE2E8F4" bordersize="0"/>
          <HorizontalLayout height="34" childpadding="10" inset="0,4,0,0">
            <Slider name="sliderDemo" value="60" min="0" max="100" thumbimage="" thumbsize="14,14" commonheight="14"/>
            <Label name="lblSliderValue" text="60%" width="60" font="0" textcolor="0xFF2D5BD7"/>
          </HorizontalLayout>

          <Label text="⑥ ScrollBar（独立滚动条演示，容器内 vscrollbar 属性更常用）" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <HorizontalLayout height="70" childpadding="10">
            <VerticalLayout bkcolor="0xFFF7F9FC" bordercolor="0xFFE2E6ED" bordersize="1">
              <Label text="↑ 这块区域演示容器滚动 ↓  滚动鼠标滚轮试试" textcolor="0xFF8A94A6" height="24" align="center"/>
              <ScrollableVerticalLayout name="scrollArea" vscrollbar="true" height="44" inset="8,4,8,4">
                <Label text="滚动内容行 1" height="20" font="2"/>
                <Label text="滚动内容行 2" height="20" font="2"/>
                <Label text="滚动内容行 3" height="20" font="2"/>
              </ScrollableVerticalLayout>
            </VerticalLayout>
          </HorizontalLayout>
        </VerticalLayout>

        <!-- ============ 第1页：输入控件 ============ -->
        <VerticalLayout childpadding="10">
          <Label text="① Edit（单行输入）— tipvalue / password / numberonly" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <VerticalLayout childpadding="8" height="120">
            <HorizontalLayout height="28" childpadding="8">
              <Label text="用户名：" width="80" font="0" textcolor="0xFF666666"/>
              <Edit name="editUser" text="" tipvalue="请输入用户名（tipvalue 提示）" width="260" height="28" bordersize="1"
                    bordercolor="0xFFD8DCE3" hotbordercolor="0xFF3A7AFF" focusedbordercolor="0xFF3A7AFF" textpadding="6,2,6,2"/>
            </HorizontalLayout>
            <HorizontalLayout height="28" childpadding="8">
              <Label text="密  码：" width="80" font="0" textcolor="0xFF666666"/>
              <Edit name="editPwd" password="true" passwordchar="●" tipvalue="密码框（password=true）" width="260" height="28" bordersize="1"
                    bordercolor="0xFFD8DCE3" hotbordercolor="0xFF3A7AFF" focusedbordercolor="0xFF3A7AFF" textpadding="6,2,6,2"/>
            </HorizontalLayout>
            <HorizontalLayout height="28" childpadding="8">
              <Label text="年  龄：" width="80" font="0" textcolor="0xFF666666"/>
              <Edit name="editAge" numberonly="true" text="18" maxchar="3" width="120" height="28" bordersize="1"
                    bordercolor="0xFFD8DCE3" textpadding="6,2,6,2"/>
              <Button name="btnSubmit" text="提交（Notify 示例）" width="150" height="28" bordersize="0"/>
            </HorizontalLayout>
          </VerticalLayout>

          <Label text="② RichEdit（富文本多行编辑）— wanttab/wantreturn/vscrollbar" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <RichEdit name="richDemo" height="110" vscrollbar="true" multiline="true" wanttab="false" wantreturn="true"
                    rich="true" textcolor="0xFF333333" font="2" bordersize="1" bordercolor="0xFFD8DCE3"
                    tipvalue="多行富文本编辑器：支持换行、滚动、富文本属性…" textpadding="6,4,6,4"/>

          <Label text="③ Combo / ComboBox（下拉框）" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <HorizontalLayout height="28" childpadding="8">
            <Combo name="comboCity" width="220" height="28" itemfont="0" itemtextcolor="0xFF333333"
                   itemselectedbkcolor="0xFFEAF1FF" normalimage="" textpadding="6,2,24,2">
              <ListLabelElementUI text="北京" selected="true"/>
              <ListLabelElementUI text="上海"/>
              <ListLabelElementUI text="广州"/>
              <ListLabelElementUI text="深圳"/>
              <ListLabelElementUI text="杭州"/>
            </Combo>
            <Label name="lblComboSel" text="当前选择：北京" textcolor="0xFF8A94A6" align="left" vcenter="true"/>
          </HorizontalLayout>

          <Label text="④ HotKey（热键输入）" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <HorizontalLayout height="28" childpadding="8">
            <HotKey name="hotkeyDemo" width="220" height="28" nativebkcolor="0xFFFFFFFF"/>
            <Label text="原生热键控件封装，按下组合键即录入" textcolor="0xFF8A94A6" align="left" vcenter="true"/>
          </HorizontalLayout>

          <Label text="⑤ IPAddress（IP 地址输入）与 DateTime（日期时间）" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <HorizontalLayout height="30" childpadding="8">
            <IPAddress name="ipDemo" width="180" height="30" nativebkcolor="0xFFFFFFFF"/>
            <DateTime name="dateDemo" width="200" height="30" nativebkcolor="0xFFFFFFFF"/>
            <Label text="两者均为 Win32 原生控件封装（SysDateTimePick32 等）" textcolor="0xFF8A94A6" align="left" vcenter="true"/>
          </HorizontalLayout>
        </VerticalLayout>

        <!-- ============ 第2页：高级控件 ============ -->
        <ScrollableVerticalLayout vscrollbar="true" childpadding="10" inset="0,0,10,0">
          <Label text="① ColorPalette（颜色选择板）— ColorPaletteUI" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <HorizontalLayout height="150" childpadding="10">
            <ColorPalette name="colorPalette" width="300" height="150" bkcolor="0xFFF7F9FC" bordercolor="0xFFE2E6ED" bordersize="1"/>
            <VerticalLayout>
              <Label name="lblColor" text="点击左侧色板取色" font="0" textcolor="0xFF666666" height="26"/>
              <HorizontalLayout height="30" childpadding="6">
                <Label text="示例色块：" width="70" font="0"/>
                <Label width="60" height="26" bkcolor="0xFFE64C4C"/>
                <Label width="60" height="26" bkcolor="0xFFF8B500"/>
                <Label width="60" height="26" bkcolor="0xFF28C76F"/>
                <Label width="60" height="26" bkcolor="0xFF3A7AFF"/>
              </HorizontalLayout>
            </VerticalLayout>
          </HorizontalLayout>

          <Label text="② PageControl（分页控件）— maxpage=&quot;总页数,显示页数&quot;" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <PageControl name="pageDemo" maxpage="10,5" height="40"/>

          <Label text="③ Loading（加载动画）— time/spoke/thickness/outradius/innerradius" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <HorizontalLayout height="70" childpadding="20" bkcolor="0xFFF7F9FC" bordercolor="0xFFE2E6ED" bordersize="1">
            <Loading width="48" height="48" time="120" spoke="8" thickness="4" outradius="18" innerradius="10" color="0xFF3A7AFF"/>
            <Loading width="48" height="48" time="200" spoke="12" thickness="3" outradius="20" innerradius="12" color="0xFF28C76F"/>
            <Loading width="48" height="48" time="80" spoke="6" thickness="6" outradius="20" innerradius="8" color="0xFFF8B500"/>
            <Label text="纯 GDI 绘制的加载动画，无需图片资源" textcolor="0xFF8A94A6" align="left" vcenter="true"/>
          </HorizontalLayout>

          <Label text="④ Ring（环形进度）— bkimage 指定环形图" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <HorizontalLayout height="60" childpadding="20" bkcolor="0xFFF7F9FC" bordercolor="0xFFE2E6ED" bordersize="1">
            <Ring text="68%" width="60" height="60" font="2" textcolor="0xFF3A7AFF"/>
            <Label text="Ring 控件继承自 Label，配合 bkimage 环形图做旋转进度" textcolor="0xFF8A94A6" align="left" vcenter="true"/>
          </HorizontalLayout>

          <Label text="⑤ RollText（滚动文字公告栏）— 代码调用 BeginRoll 启动" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <HorizontalLayout height="34" childpadding="8" bkcolor="0xFFFFF7E8" bordercolor="0xFFF5D89A" bordersize="1">
            <Label text="📢" width="30" font="0"/>
            <RollText name="rollNotice" text="这是一条滚动公告：DuiLib_Ultimate 支持全部控件自绘，轻松打造桌面应用皮肤！  " font="0" textcolor="0xFFB26A00" align="left"/>
            <Button name="btnRollStart" text="启动" width="60" height="26" bordersize="0"/>
            <Button name="btnRollStop"  text="停止" width="60" height="26" bordersize="0"/>
          </HorizontalLayout>
        </ScrollableVerticalLayout>

        <!-- ============ 第3页：列表与树 ============ -->
        <VerticalLayout childpadding="8">
          <Label text="① List（报表列表）：ListHeader + ListHeaderItem + ListTextElement（含多选）" font="1" height="22" textcolor="0xFF2D5BD7"/>
          <List name="listDemo" vscrollbar="true" header="true" headerbkcolor="0xFFF0F3F8" itemfont="0"
                itemtextcolor="0xFF333333" itemselectedbkcolor="0xFFE3EEFF" itemhotbkcolor="0xFFF0F6FF"
                altrowcolor="0xFFF7F9FC" itemaltbk="true" bordersize="1" bordercolor="0xFFE2E6ED" height="150">
            <ListHeader height="30">
              <ListHeaderItem text="姓名" width="140" dragable="true" sepwidth="4"/>
              <ListHeaderItem text="部门" width="160" dragable="true" sepwidth="4"/>
              <ListHeaderItem text="城市" width="140" dragable="true" sepwidth="4"/>
              <ListHeaderItem text="职位" dragable="true" sepwidth="4"/>
            </ListHeader>
          </List>

          <Label text="② List 多选（multiselect=true，Ctrl/Shift 操作；右键菜单演示 Menu 控件）" font="1" height="22" textcolor="0xFF2D5BD7"/>
          <List name="listMulti" vscrollbar="true" header="false" multiselect="true" itemfont="0"
                itemtextcolor="0xFF333333" itemselectedbkcolor="0xFFE3EEFF" itemhotbkcolor="0xFFF0F6FF" height="120"
                bordersize="1" bordercolor="0xFFE2E6ED">
          </List>

          <Label text="③ ListContainerElement（容器行：行内可放任意控件）" font="1" height="22" textcolor="0xFF2D5BD7"/>
          <List name="listContainer" vscrollbar="true" header="false" itemfont="0" height="120"
                bordersize="1" bordercolor="0xFFE2E6ED">
          </List>

          <Label text="④ TreeView + TreeNode（树控件）— visiblefolderbtn/visiblecheckbtn" font="1" height="22" textcolor="0xFF2D5BD7"/>
          <TreeView name="treeDemo" vscrollbar="true" itemfont="0" visiblefolderbtn="true" visiblecheckbtn="false"
                    itemminwidth="80" height="150" bordersize="1" bordercolor="0xFFE2E6ED" bkcolor="0xFFFBFCFE">
            <TreeNode text="DuiLib 源码目录" expland="true" height="26" textcolor="0xFF333333">
              <TreeNode text="Core（核心：消息循环/绘制/资源）" height="24" textcolor="0xFF666666"/>
              <TreeNode text="Control（控件实现）" height="24" textcolor="0xFF666666" expland="true">
                <TreeNode text="UIList.cpp" height="22" textcolor="0xFF888888"/>
                <TreeNode text="UIRichEdit.cpp" height="22" textcolor="0xFF888888"/>
                <TreeNode text="UIWebBrowser.cpp" height="22" textcolor="0xFF888888"/>
              </TreeNode>
              <TreeNode text="Layout（布局容器）" height="24" textcolor="0xFF666666"/>
              <TreeNode text="Utils（工具类）" height="24" textcolor="0xFF666666"/>
            </TreeNode>
            <TreeNode text="Demos（示例工程）" height="26" textcolor="0xFF333333"/>
          </TreeView>
        </VerticalLayout>

        <!-- ============ 第4页：布局容器 ============ -->
        <VerticalLayout childpadding="10">
          <Label text="① VerticalLayout / HorizontalLayout（纵横布局：inset、childpadding、float）" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <HorizontalLayout height="110" childpadding="8">
            <VerticalLayout bkcolor="0xFFEAF1FF" inset="8,8,8,8" childpadding="4" width="220">
              <Label text="VerticalLayout（纵向）" font="2" height="20" textcolor="0xFF2D5BD7"/>
              <HorizontalLayout height="22" bkcolor="0xFFD6E4FF"><Label text="子项 1" font="2" textcolor="0xFF2D5BD7" align="center"/></HorizontalLayout>
              <HorizontalLayout height="22" bkcolor="0xFFD6E4FF"><Label text="子项 2" font="2" textcolor="0xFF2D5BD7" align="center"/></HorizontalLayout>
              <HorizontalLayout height="22" bkcolor="0xFFD6E4FF"><Label text="子项 3" font="2" textcolor="0xFF2D5BD7" align="center"/></HorizontalLayout>
            </VerticalLayout>
            <VerticalLayout bkcolor="0xFFF0FFF4" inset="8,8,8,8" childpadding="4">
              <Label text="HorizontalLayout（横向）：三个等分块 ↓" font="2" height="20" textcolor="0xFF1B8F4F"/>
              <HorizontalLayout height="60" childpadding="4">
                <Label text="1/3" bkcolor="0xFFBFF0CF" font="2" textcolor="0xFF1B8F4F" align="center" vcenter="true"/>
                <Label text="1/3" bkcolor="0xFFBFF0CF" font="2" textcolor="0xFF1B8F4F" align="center" vcenter="true"/>
                <Label text="1/3" bkcolor="0xFFBFF0CF" font="2" textcolor="0xFF1B8F4F" align="center" vcenter="true"/>
              </HorizontalLayout>
            </VerticalLayout>
          </HorizontalLayout>

          <Label text="② TileLayout（平铺布局）— columns / itemsize" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <TileLayout columns="5" itemsize="0,64" height="140" childpadding="8" bkcolor="0xFFF7F9FC" bordercolor="0xFFE2E6ED" bordersize="1" inset="8,8,8,8">
            <Label text="格子 1" bkcolor="0xFFE3EEFF" font="2" textcolor="0xFF2D5BD7" align="center" vcenter="true"/>
            <Label text="格子 2" bkcolor="0xFFE3EEFF" font="2" textcolor="0xFF2D5BD7" align="center" vcenter="true"/>
            <Label text="格子 3" bkcolor="0xFFE3EEFF" font="2" textcolor="0xFF2D5BD7" align="center" vcenter="true"/>
            <Label text="格子 4" bkcolor="0xFFE3EEFF" font="2" textcolor="0xFF2D5BD7" align="center" vcenter="true"/>
            <Label text="格子 5" bkcolor="0xFFE3EEFF" font="2" textcolor="0xFF2D5BD7" align="center" vcenter="true"/>
            <Label text="格子 6" bkcolor="0xFFE3EEFF" font="2" textcolor="0xFF2D5BD7" align="center" vcenter="true"/>
            <Label text="格子 7" bkcolor="0xFFE3EEFF" font="2" textcolor="0xFF2D5BD7" align="center" vcenter="true"/>
            <Label text="格子 8" bkcolor="0xFFE3EEFF" font="2" textcolor="0xFF2D5BD7" align="center" vcenter="true"/>
            <Label text="格子 9" bkcolor="0xFFE3EEFF" font="2" textcolor="0xFF2D5BD7" align="center" vcenter="true"/>
            <Label text="格子 10" bkcolor="0xFFE3EEFF" font="2" textcolor="0xFF2D5BD7" align="center" vcenter="true"/>
          </TileLayout>

          <Label text="③ TabLayout（选项卡容器，本 Demo 右侧主体即用它）+ 代码/属性切换" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <HorizontalLayout height="60" childpadding="8">
            <TabLayout name="tabMini" selected="0" bkcolor="0xFFF7F9FC" bordercolor="0xFFE2E6ED" bordersize="1">
              <VerticalLayout bkcolor="0xFFEAF1FF" inset="10,6,10,6">
                <Label text="Tab 第 1 页 —— TabLayout 用 selected 属性切换默认页，代码用 SelectItem(i)" font="2" textcolor="0xFF2D5BD7"/>
              </VerticalLayout>
              <VerticalLayout bkcolor="0xFFF0FFF4" inset="10,6,10,6">
                <Label text="Tab 第 2 页 —— 配合 Button 的 bindtabindex 属性可零代码实现页签导航" font="2" textcolor="0xFF1B8F4F"/>
              </VerticalLayout>
      
            <VerticalLayout width="150" childpadding="6" inset="0,0,0,0">
              <Button name="btnTabPrev" text="◀ 上一页" height="26" bordersize="0"/>
              <Button name="btnTabNext" text="下一页 ▶" height="26" bordersize="0"/>
            </VerticalLayout>
          </HorizontalLayout>

          <Label text="④ AnimationTabLayout（动画选项卡）— animation_direction=vertical/horizontal" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <VerticalLayout height="90" childpadding="6">
            <HorizontalLayout height="30" childpadding="8">
              <Button text="动画Tab 页1" bindtablayoutname="tabAnim" bindtabindex="0" width="130"/>
              <Button text="动画Tab 页2" bindtablayoutname="tabAnim" bindtabindex="1" width="130"/>
            </HorizontalLayout>
            <AnimationTabLayout name="tabAnim" animation_direction="vertical" height="52">
              <VerticalLayout bkcolor="0xFFFFF0F0" inset="10,6,10,6">
                <Label text="AnimationTab 第 1 页 —— 切换时带滑动动画" font="2" textcolor="0xFFC43838"/>
              </VerticalLayout>
              <VerticalLayout bkcolor="0xFFF0F7FF" inset="10,6,10,6">
                <Label text="AnimationTab 第 2 页 —— 继承自 TabLayout" font="2" textcolor="0xFF2D5BD7"/>
              </VerticalLayout>
            </AnimationTabLayout>
          </VerticalLayout>

          <Label text="⑤ ChildLayout（子 XML 嵌入）— xmlfile 属性引用外部布局文件" font="1" height="24" textcolor="0xFF2D5BD7"/>
          <ChildLayout xmlfile="child_panel.xml" height="54" childpadding="0"/>
        </VerticalLayout>


        <!-- ============ 第6页：窗口与嵌入 ============ -->
        <VerticalLayout childpadding="10">
          <Label text="① ActiveX（ActiveX 宿主容器）" font="1" height="24" textcolor="0xFF2D5BD7"/>
